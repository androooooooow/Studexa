# -------------------------------------------------------------
# Studexa AI — Backend Environment Configuration
# -------------------------------------------------------------
APP_NAME=Studexa AI
ENVIRONMENT=production

# --- AI Engine Selection ---
# Set to 'cloudflare' for Render/Production (uses Cloudflare Workers AI with Gemma)
# Set to 'ollama' for local machine development with Ollama
AI_PROVIDER=cloudflare

# --- Cloudflare Workers AI (Google Gemma) ---
# Required when AI_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# Available Gemma models on Cloudflare Workers AI:
# @cf/google/gemma-7b-it
# @cf/google/gemma-2-9b-it
# @cf/google/gemma-2-27b-it
# @cf/google/gemma-4-26b-a4b-it
CLOUDFLARE_MODEL=@cf/google/gemma-7b-it

# --- Local Ollama (Development) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b

# --- Concurrency & Queue Limits ---
AI_MAX_CONCURRENT=2
AI_MAX_QUEUE=20

# --- Storage & Database Configuration ---
# On Render without persistent disk, storage will use local ./storage directory.
# On Render with persistent disk mounted at /opt/studymate/storage:
DATABASE_URL=sqlite:////opt/studymate/storage/database/studymate.db
UPLOAD_DIR=/opt/studymate/storage/uploads
GENERATED_DIR=/opt/studymate/storage/generated
MAX_UPLOAD_SIZE_MB=20
SESSION_TTL_DAYS=30

# --- CORS Settings ---
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment)
# Use * for wildcard or include your Vercel domains:
CORS_ORIGINS=https://studexa.vercel.app,https://*.vercel.app,http://localhost:5173

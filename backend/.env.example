APP_NAME=StudyMate AI
ENVIRONMENT=production
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
AI_MAX_CONCURRENT=1
AI_MAX_QUEUE=10
DATABASE_URL=sqlite:////opt/studymate/storage/database/studymate.db
UPLOAD_DIR=/opt/studymate/storage/uploads
GENERATED_DIR=/opt/studymate/storage/generated
MAX_UPLOAD_SIZE_MB=20
SESSION_TTL_DAYS=30
CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN
